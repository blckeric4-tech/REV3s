# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local dev/prod server logs
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local database — the live data now lives in TiDB. Never commit dev.db.
prisma/dev.db
prisma/dev.db-journal
prisma/*.db

# Customer uploads ARE committed deliberately. Render's filesystem is wiped on
# every redeploy, so these files must ship with the code or every product image
# breaks. See DEPLOY.md section 7 — this is a stopgap until object storage.
# To migrate to S3/R2 later, delete the four lines below.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
