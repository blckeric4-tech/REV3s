# ── Database ──────────────────────────────────────────────────────────
# TiDB Cloud Starter (free). From the cluster's Connect dialog -> Prisma.
# Public endpoint MUST use TLS, hence sslaccept=strict.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/rav3s?sslaccept=strict"

# ── Sessions ──────────────────────────────────────────────────────────
# Signs admin and customer session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this signs every visitor out.
SESSION_SECRET=""

# ── Admin login ───────────────────────────────────────────────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Payments ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Mobile money (East Africa). Optional — omit to hide those methods at checkout.
PAYPACK_CLIENT_ID=""
PAYPACK_CLIENT_SECRET=""
PAYPACK_MODE="sandbox"
PAYPACK_WEBHOOK_SECRET=""

FLW_CLIENT_ID=""
FLW_CLIENT_SECRET=""
FLW_ENCRYPTION_KEY=""
FLW_ENV="sandbox"
FLW_WEBHOOK_SECRET=""

# ── Site ──────────────────────────────────────────────────────────────
# Your public origin, no trailing slash. Must be the deployed URL so payment
# webhooks and redirect URLs are built correctly.
NEXT_PUBLIC_SITE_URL=""
